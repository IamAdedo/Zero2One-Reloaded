# Zero2One env — copy to .env and fill in
# Browser (Vite exposes only VITE_ vars to client bundles)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server (server functions / SSR only — never expose service key to client)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI coach / judges
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Execution fallbacks
JUDGE0_URL=
JUDGE0_KEY=

# App
USE_MOCK_DATA=true
LOG_LEVEL=info
